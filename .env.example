# =============================================================================
# LLM 大模型配置（任选其一，兼容所有 OpenAI API 格式的模型）
# =============================================================================
# 通用配置项（推荐使用这组变量名）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 也兼容旧版变量名（如果同时设置了 LLM_* 和 DEEPSEEK_*，LLM_* 优先）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- 各模型配置示例（取消注释并填入 Key 即可切换）---
#
# DeepSeek（默认，性价比高）
#   申请地址: https://platform.deepseek.com/
#   LLM_API_KEY=your_deepseek_api_key
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# OpenAI / ChatGPT
#   申请地址: https://platform.openai.com/
#   LLM_API_KEY=your_openai_api_key
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#
# 通义千问 / Qwen（阿里云）
#   申请地址: https://dashscope.console.aliyun.com/
#   LLM_API_KEY=your_dashscope_api_key
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
# 智谱 GLM（智谱AI）
#   申请地址: https://open.bigmodel.cn/
#   LLM_API_KEY=your_zhipu_api_key
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
#
# 月之暗面 Kimi（Moonshot）
#   申请地址: https://platform.moonshot.cn/
#   LLM_API_KEY=your_moonshot_api_key
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
#
# 百度文心一言 / ERNIE
#   申请地址: https://console.bce.baidu.com/qianfan/
#   LLM_API_KEY=your_qianfan_api_key
#   LLM_BASE_URL=https://qianfan.baidubce.com/v2
#   LLM_MODEL=ernie-4.0-8k
#
# SiliconFlow（硅基流动，聚合多种开源模型）
#   申请地址: https://cloud.siliconflow.cn/
#   LLM_API_KEY=your_siliconflow_api_key
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=deepseek-ai/DeepSeek-V3

# =============================================================================
# Tavily 搜索 API
# =============================================================================
# 申请地址: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# 图片 API（按 Unsplash → Pexels → Pixabay → Tavily 顺序尝试，配置越多越稳定）
# =============================================================================

# Unsplash 图片 API
# 申请地址: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pexels 图片 API（可选，免费版每月 20,000 次请求）
# 申请地址: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay 图片 API（可选，支持中文搜索，国内访问友好，免费版每分钟 100 次）
# 申请地址: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# =============================================================================
# 小红书浏览器自动化设置
# =============================================================================
# true = 无头模式（后台运行），false = 可见浏览器（调试用）
# 首次登录会自动切换为可见模式供扫码
XHS_HEADLESS=true
